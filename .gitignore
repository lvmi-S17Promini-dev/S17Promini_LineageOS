# Allow only documented project inputs, diagnostics and selected small artifacts.
/*
!/.gitignore
!/.gitattributes
!/.githooks/
!/README.md
!/docs/
!/tools/
!/mtkclient-to-fastboot/
!/charger-debug/
!/recovery-debug/
!/lineage-debug/
!/artifacts/
!/extracted/
!/ref/
!/stock_imgs/

# Derived filesystems and raw backup sets remain local.
/extracted/*
!/extracted/metadata/
/extracted/metadata/*
!/extracted/metadata/*.txt
!/extracted/metadata/*.json
!/extracted/metadata/*.log
!/extracted/metadata/*.dts
!/extracted/metadata/*.diff
!/extracted/metadata/*.config
/extracted/metadata/build-*.log
/extracted/metadata/*-extract.log
/extracted/metadata/generate-*.log
/extracted/metadata/vendor-inode-stats.txt

# Camera reverse-engineering evidence; keep generated build chatter local.
!/extracted/metadata/stock-camera-bounds.tsv
!/extracted/metadata/stock-gc5025sub-bounds.tsv
!/extracted/metadata/ghidra-camera/
!/extracted/metadata/ghidra-gc5025sub/
/extracted/metadata/ghidra-camera/*
/extracted/metadata/ghidra-gc5025sub/*
!/extracted/metadata/ghidra-camera/*.c
!/extracted/metadata/ghidra-gc5025sub/*.c
/extracted/metadata/imx278-build.log
/extracted/metadata/imx278-boot-build.log
/extracted/metadata/imx278-boot-lunch.log
/extracted/metadata/imx278-subtree-build.log
/extracted/metadata/gc5025sub-subtree-build.log
/extracted/metadata/camera-r13-build.log
/extracted/metadata/camera-r13-lunch.log
/extracted/metadata/ghidra-camera.log
/extracted/metadata/ghidra-gc5025sub.log
!/extracted/metadata/stock-flash-bounds.tsv
!/extracted/metadata/ghidra-flash/
/extracted/metadata/ghidra-flash/*
!/extracted/metadata/ghidra-flash/*.c
/extracted/metadata/ghidra-flash.log
/extracted/metadata/flash-r14-build.log
/extracted/metadata/flash-r14-lunch.log
/extracted/metadata/flash-r14-host-tests.log

# PSC5425E reverse-engineering evidence; build and capture logs remain local.
!/extracted/metadata/stock-psc5425e-bounds.tsv
!/extracted/metadata/ghidra-psc5425e/
/extracted/metadata/ghidra-psc5425e/*
!/extracted/metadata/ghidra-psc5425e/*.c
/extracted/metadata/psc5425e-*.log

# Keep the kernel config; third-party checkout contents are reproducible references.
/ref/*
!/ref/内核config.gz.txt

# Artifact metadata is small; binary artifacts are explicitly selected below.
/artifacts/**
!/artifacts/**/
!/artifacts/**/*.md
!/artifacts/**/*.json
!/artifacts/**/*.txt
!/artifacts/**/SHA256SUMS
!/artifacts/**/*.sha256sum

# All other original partitions stay in the external backup set.
/stock_imgs/*

# Never add large image/package outputs automatically.
*.img
*.bin
*.dtb
*.dtbo
*.zip
*.7z
*.tar
*.gz
*.xz
*.zst
*.elf
*.o
*.so
*.py[cod]
__pycache__/
**/.git/
*:Zone.Identifier

# Selected images/binaries <= 50 MiB; stage-size hook enforces the limit.
!/artifacts/boot-kmsg-debug.img
!/artifacts/boot-normal-r1.img
!/artifacts/lk-keys-fastboot-r2.img
!/artifacts/lk-volup-fastboot-r1.img
!/artifacts/recovery-384.img
!/artifacts/recovery-r2.img
!/artifacts/recovery-r3.img
!/artifacts/recovery-r4.img
!/artifacts/recovery-r5.img
!/artifacts/recovery.img
!/artifacts/rom-charger-adb-r2/vbmeta.img
!/artifacts/rom-charger-backlight-r3/vbmeta.img
!/artifacts/rom-charger-backlight-r4/vbmeta.img
!/artifacts/rom-charger-r1/vbmeta.img
!/artifacts/rom-firstboot/vbmeta-disabled.img
!/artifacts/rom-firstboot/vbmeta.img
!/artifacts/rom-generated-recovery/recovery.img
!/extracted/metadata/dtb-0.dtb
!/extracted/metadata/lk-builtin.dtb
!/extracted/metadata/stock-overlay-0.dtbo
!/stock_imgs/boot.bin
!/stock_imgs/recovery.bin
!/stock_imgs/lk.bin
!/stock_imgs/lk2.bin
!/stock_imgs/dtbo.bin
!/stock_imgs/logo.bin
!/stock_imgs/vbmeta.bin
!/stock_imgs/vbmeta_system.bin
!/stock_imgs/vbmeta_vendor.bin
!/artifacts/boot-kmsg-collector-test

